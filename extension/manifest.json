{
  "manifest_version": 3,
  "name": "Nexus AI",
  "version": "0.2.0",
  "description": "Let a local AI click, type, and read the current tab via a localhost bridge. 7-day free trial, then $5/month.",
  "homepage_url": "https://fitzyracing1.github.io/nexus-ai/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:17777/*",
    "http://127.0.0.1:8787/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nexus AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://fitzyracing1.github.io/nexus-ai/*",
        "http://127.0.0.1:8787/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
